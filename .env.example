# Supabase → Connect → ORMs → Prisma. Use a letters-and-numbers password (or URL-encode symbols).
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5"
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"
# Optional, only on your PC: the session pooler string (port 5432) is much faster from far away. Vercel ignores it.
DATABASE_URL_LOCAL=
NEXT_PUBLIC_BRAND_NAME=WA Platform
# Free wallet credit for new accounts, in rupees
SIGNUP_BONUS_RUPEES=20

# Meta app (Tech Provider) — App Dashboard → App settings → Basic
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v24.0
# Any random string; enter the same value as the webhook "Verify token" in the App Dashboard
META_WEBHOOK_VERIFY_TOKEN=
# Our business portfolio ID; sellers enter it under "Assign partner" in WhatsApp Manager
META_BUSINESS_ID=
# Admin system user (Business settings → System users) and its token with
# whatsapp_business_management, whatsapp_business_messaging and business_management
META_SYSTEM_USER_ID=
META_SYSTEM_USER_TOKEN=

# 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
# Random secret used to hash OTP codes
OTP_HASH_SECRET=

# Embedded Signup: Meta app → Facebook Login for Business → Configurations → WhatsApp Embedded Signup
META_ES_CONFIG_ID=

# Wallet recharge (Razorpay dashboard → Account & Settings → API keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay → Webhooks → URL https://your-domain/api/webhooks/razorpay, events order.paid + payment.captured
RAZORPAY_WEBHOOK_SECRET=

# Protects /api/cron/campaigns; Vercel Cron sends it automatically
CRON_SECRET=

# Public URL of the app, no trailing slash: used in emails, SEO and links
APP_URL=http://localhost:3000
# Shown on the website, legal pages and footer
COMPANY_NAME=
SUPPORT_EMAIL=
# Password reset emails (resend.com). Without a key, emails are printed to the server log.
RESEND_API_KEY=
EMAIL_FROM=
